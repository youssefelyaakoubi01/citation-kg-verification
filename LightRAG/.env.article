# Runtime configuration keys read by analysis/*.py (Table III). Copied from the server .env
# at ingestion time; credentials and settings of unused back ends are deliberately omitted.
CLAUDE_AGENT_SDK_EFFORT=medium
EMBEDDING_BINDING=openai
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_LLM_CACHE=true
ENTITY_EXTRACTION_USE_JSON=true
ENTITY_TYPE_PROMPT_FILE=scientific_citation.yml
KG_ENTITY_LOOKUP_METHOD=LABEL
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_PARSER=*:native-teP,*:legacy-R
LIGHTRAG_VECTOR_STORAGE=NoopVectorDBStorage
LLM_BINDING=claude_agent_sdk
LLM_MODEL=claude-opus-5-5
MAX_ASYNC_LLM=4
MAX_PARALLEL_INSERT=3
RERANK_BINDING=null
SUMMARY_LANGUAGE=English
