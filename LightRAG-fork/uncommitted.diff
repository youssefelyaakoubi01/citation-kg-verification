+def _split_keyword_terms(keywords: str) -> list[str]:
+    """Split the comma-joined keyword string into unique non-blank terms.
+
+    Order is kept; duplicates are dropped case-insensitively.
+    """
+    terms: list[str] = []
+    seen: set[str] = set()
+    for raw in (keywords or "").split(","):
+        term = raw.strip()
+        key = term.lower()
+        if term and key not in seen:
+            seen.add(key)
+            terms.append(term)
+    return terms
+
+
+def _vector_chunks_available(chunks_vdb: BaseVectorStorage | None) -> bool:
+    """False only when ``chunks_vdb`` declares ``persists_vectors=False``.
+
+    ``None`` stays True on purpose: callers that pass no chunks VDB keep the
+    pre-existing behaviour (the query is still embedded for KG chunk
+    selection); only a storage that says it holds nothing disables it.
+    """
+    return chunks_vdb is None or bool(getattr(chunks_vdb, "persists_vectors", True))
+
+
+_LABEL_TOKEN_MIN_LEN = 3
+
+
+async def _search_entity_labels(
+    keywords: str,
+    knowledge_graph_inst: BaseGraphStorage,
+    top_k: int,
+) -> list[str]:
+    """Resolve keywords to entity names with ``BaseGraphStorage.search_labels``.
+
+    Each term is searched whole first. Only when a multi-word term matches
+    nothing are its whitespace tokens of at least ``_LABEL_TOKEN_MIN_LEN``
+    characters searched, so "Ikhlass Boukrouh" still reaches a node stored
+    as "Boukrouh, Ikhlass". Hits are merged round-robin across terms (each
+    list is already relevance-sorted by the backend), deduplicated, and capped
+    at ``top_k``. Backend errors propagate; an empty list means no match.
+    """
+    if top_k <= 0:
+        return []
+
+    per_term_hits: list[list[str]] = []
+    for term in _split_keyword_terms(keywords):
+        hits = await knowledge_graph_inst.search_labels(term, limit=top_k)
+        if not hits and " " in term:
+            for token in term.split():
+                if len(token) >= _LABEL_TOKEN_MIN_LEN:
+                    hits.extend(
+                        await knowledge_graph_inst.search_labels(token, limit=top_k)
+                    )
+        if hits:
+            per_term_hits.append(hits)
+
+    merged: list[str] = []
+    seen: set[str] = set()
+    for i in range(max((len(h) for h in per_term_hits), default=0)):
+        for hits in per_term_hits:
+            if i < len(hits) and hits[i] not in seen:
+                seen.add(hits[i])
+                merged.append(hits[i])
+                if len(merged) >= top_k:
+                    return merged
+    return merged
+
+
+async def _get_node_data_by_label(
+    keywords: str,
+    knowledge_graph_inst: BaseGraphStorage,
+    query_param: QueryParam,
+) -> tuple[list[dict], list[dict]]:
+    """LABEL counterpart of ``_get_node_data``: no vector index involved."""
+    names = await _search_entity_labels(
+        keywords, knowledge_graph_inst, query_param.top_k
+    )
+    if not names:
+        logger.info(f"Label lookup: 0 entities for {keywords!r}")
+        return [], []
+    logger.info(
+        f"Label lookup: {len(names)} entities for {keywords!r} (top_k:{query_param.top_k})"
+    )
+    hits = [{"entity_name": name, "created_at": None} for name in names]
+    return await _expand_entity_hits(hits, knowledge_graph_inst, query_param)
+
