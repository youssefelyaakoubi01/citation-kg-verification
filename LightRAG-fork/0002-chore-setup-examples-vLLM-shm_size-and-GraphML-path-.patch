Subject: [PATCH 2/3] chore(setup,examples): vLLM shm_size and GraphML path
 resolution

Give the vLLM embed and rerank containers a 2 GB shm_size. Let
graph_visual_with_html.py take the GraphML path as an argument or resolve
it from WORKING_DIR / ./rag_storage instead of the hard-coded dickens dir.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 examples/graph_visual_with_html.py      | 31 +++++++++++++++++++++++--
 scripts/setup/templates/vllm-embed.yml  |  1 +
 scripts/setup/templates/vllm-rerank.yml |  1 +
 3 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/examples/graph_visual_with_html.py b/examples/graph_visual_with_html.py
index 56ed43cc7..06b62655d 100644
--- a/examples/graph_visual_with_html.py
+++ b/examples/graph_visual_with_html.py
@@ -5,12 +5,39 @@ if not pm.is_installed("pyvis"):
 if not pm.is_installed("networkx"):
     pm.install("networkx")
 
+import os
+import sys
+from pathlib import Path
+
 import networkx as nx
 from pyvis.network import Network
 import random
 
-# Load the GraphML file
-G = nx.read_graphml("./dickens/graph_chunk_entity_relation.graphml")
+# Locate the GraphML file written by NetworkXStorage.
+# Usage: python graph_visual_with_html.py [path/to/graph_chunk_entity_relation.graphml]
+# Without an argument, WORKING_DIR (same variable as the server's .env) is used,
+# then the repository default ./rag_storage, then the legacy ./dickens example dir.
+GRAPHML_NAME = "graph_chunk_entity_relation.graphml"
+if len(sys.argv) > 1:
+    graphml_path = Path(sys.argv[1])
+else:
+    repo_root = Path(__file__).resolve().parent.parent
+    candidates = []
+    if os.getenv("WORKING_DIR"):
+        candidates.append(Path(os.environ["WORKING_DIR"]) / GRAPHML_NAME)
+    candidates += [
+        repo_root / "rag_storage" / GRAPHML_NAME,
+        Path("./dickens") / GRAPHML_NAME,
+    ]
+    graphml_path = next((c for c in candidates if c.is_file()), candidates[0])
+
+if not graphml_path.is_file():
+    sys.exit(f"GraphML file not found: {graphml_path}")
+
+G = nx.read_graphml(graphml_path)
+print(
+    f"Loaded {graphml_path}: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges"
+)
 
 # Create a Pyvis network
 net = Network(height="100vh", notebook=True)
diff --git a/scripts/setup/templates/vllm-embed.yml b/scripts/setup/templates/vllm-embed.yml
index b079e46a0..40843be9f 100644
--- a/scripts/setup/templates/vllm-embed.yml
+++ b/scripts/setup/templates/vllm-embed.yml
@@ -18,4 +18,5 @@
       timeout: 3s
       retries: 120
       start_period: 10s
+    shm_size: 2gb
     restart: unless-stopped
diff --git a/scripts/setup/templates/vllm-rerank.yml b/scripts/setup/templates/vllm-rerank.yml
index ad7d60b3d..15f9d4c74 100644
--- a/scripts/setup/templates/vllm-rerank.yml
+++ b/scripts/setup/templates/vllm-rerank.yml
@@ -18,4 +18,5 @@
       timeout: 3s
       retries: 120
       start_period: 10s
+    shm_size: 2gb
     restart: unless-stopped
