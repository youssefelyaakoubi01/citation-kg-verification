<node id="Colorectal Cancer Detection">
  <data key="d0">Colorectal Cancer Detection</data>
  <data key="d1">concept</data>
  <data key="d2">Task addressed with ResUNet++ combined with CRF and TTA to improve generalizability.&lt;SEP&gt;Clinical task addressed by a study leveraging ResUNet++ with CRF and TTA.</data>
  <data key="d3">doc-860e34bf4e631717387a6fc6684e1154-chunk-005&lt;SEP&gt;doc-860e34bf4e631717387a6fc6684e1154-chunk-006</data>
