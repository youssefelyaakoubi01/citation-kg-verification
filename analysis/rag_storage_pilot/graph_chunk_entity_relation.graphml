  <data key="d0">Microsoft</data>
  <data key="d1">organization</data>
  <data key="d2">Company that produces the Text Template Transformation Toolkit (T4).&lt;SEP&gt;Company that produces the Text Template Transformation Toolkit (T4), a TBCG mechanism.</data>
  <data key="d3">doc-a4aa31c8531fdbc66868e8d96c0e0d18-chunk-000&lt;SEP&gt;doc-a4aa31c8531fdbc66868e8d96c0e0d18-chunk-001</data>
