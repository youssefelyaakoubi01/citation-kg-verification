  <data key="d5">1791501149</data>
  <data key="d6"></data>
</node>
<node id="Availability">
  <data key="d0">Availability</data>
  <data key="d1">concept</data>
  <data key="d2">A critical VANET security factor that ensures the network remains operational. It is threatened by DoS, jamming, malware, greedy behaviour and spamming attacks.&lt;SEP&gt;A fundamental security concept that MANET security requires.</data>
  <data key="d3">doc-db5423cfc6b0239a805a929baa02d1e9-chunk-002&lt;SEP&gt;doc-1e0beceeffe2b62352afd4291e0fd937-chunk-001</data>
