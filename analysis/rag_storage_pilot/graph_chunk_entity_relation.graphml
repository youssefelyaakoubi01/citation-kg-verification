  <data key="d0">Yadav et al., 2024</data>
  <data key="d1">paper</data>
  <data key="d2">Experimental analysis (2024) comparing CTGAN against TVAE in different dataset settings.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-001</data>
