  <data key="d6"></data>
</node>
<node id="TOPSIS ranks alternatives by distances from ideal solutions">
  <data key="d0">TOPSIS ranks alternatives by distances from ideal solutions</data>
  <data key="d1">claim</data>
  <data key="d2">Alternatives are ranked through the calculation of an overall index based on their distances from these ideal solutions [7].</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-001</data>
