</node>
<node id="Pareto Front">
  <data key="d0">Pareto Front</data>
  <data key="d1">methodology</data>
  <data key="d2">Analysis shown in the block size vs timeout performance figure to identify optimal trade-off configurations.</data>
  <data key="d3">doc-dfeceae54500e0aef047f46e66c1451b-chunk-011</data>
  <data key="d4">Configuration_Driven_Performance_Analysis_of_Hyper.pdf</data>
