<node id="Ref (28) Decision Making">
  <data key="d0">Ref (28) Decision Making</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as (28) for the definition of decision making.</data>
  <data key="d3">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-003</data>
  <data key="d4">IJE_Volume38_Issue2_Pages488-502_Versionfinale.pdf</data>
