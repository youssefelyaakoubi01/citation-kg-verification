  <data key="d0">Property Law</data>
  <data key="d1">concept</data>
  <data key="d2">Legal domain in which the AI Lawyer provides expert answers.</data>
  <data key="d3">doc-caa1a23d50101616a42f59c788898ea5-chunk-000</data>
