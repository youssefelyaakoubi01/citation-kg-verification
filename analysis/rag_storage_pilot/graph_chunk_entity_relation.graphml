<node id="Larasati et al. [19]">
  <data key="d0">Larasati et al. [19]</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as [19]. Examines customer churn at Indonesian telecom company PT. XYZ with an optimized ANN deep learning algorithm achieving 76.35% accuracy; identifies contract type and service type as influential variables.</data>
  <data key="d3">doc-3b6de35b4fc6654223999680ef1082ec-chunk-002</data>
  <data key="d4">25293-55764-1-PB.pdf</data>
