</node>
<node id="Code of Obligations and Contracts">
  <data key="d0">Code of Obligations and Contracts</data>
  <data key="d1">dataset</data>
  <data key="d2">Moroccan law (COC) promulgated by the Dahir of August 12, 1913, foundation of contract law in Morocco; used as the source of a French-language dataset of legal articles categorized by thematic sections such as General Obligations, Electronic Contracts, Quasi-Contracts, Torts and Liabilities, Contractual Terms, and Solidarity.</data>
  <data key="d3">doc-caa1a23d50101616a42f59c788898ea5-chunk-004</data>
  <data key="d4">Paper_113-Accurate_AI_Assistance_in_Contract_Law1.pdf</data>
  <data key="d5">1791500933</data>
  <data key="d6"></data>
</node>
<node id="Document Chunking">
  <data key="d0">Document Chunking</data>
  <data key="d1">methodology</data>
  <data key="d2">Pre-processing step that segments legal documentation into manageable chunks.</data>
  <data key="d3">doc-caa1a23d50101616a42f59c788898ea5-chunk-004</data>
  <data key="d4">Paper_113-Accurate_AI_Assistance_in_Contract_Law1.pdf</data>
