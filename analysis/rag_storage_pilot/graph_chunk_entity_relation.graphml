  <data key="d6"></data>
</node>
<node id="Latency Increases Sharply At 6–8 Peers Per Organization">
  <data key="d0">Latency Increases Sharply At 6–8 Peers Per Organization</data>
  <data key="d1">claim</data>
  <data key="d2">Finding of the paper: "However, as the number of peers increases to 6–8 peers per organization, there is a significant increase in latency."</data>
  <data key="d3">doc-dfeceae54500e0aef047f46e66c1451b-chunk-011</data>
  <data key="d4">Configuration_Driven_Performance_Analysis_of_Hyper.pdf</data>
