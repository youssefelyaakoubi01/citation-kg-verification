  <data key="d0">Youssra Amazou</data>
  <data key="d1">author</data>
  <data key="d2">Author of the article on accurate AI assistance in contract law using RAG, affiliated with Abdelmalek Essaadi University.&lt;SEP&gt;Co-author of the fuzzy-Bayesian vehicle accident risk paper, affiliated with Abdelmalek Essaadi University.</data>
  <data key="d3">doc-caa1a23d50101616a42f59c788898ea5-chunk-000&lt;SEP&gt;doc-a503621d914a716d7d3a5232c23b6bc6-chunk-000</data>
