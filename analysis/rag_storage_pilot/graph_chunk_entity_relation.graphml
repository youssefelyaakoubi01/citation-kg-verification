<node id="European Parliament, 2020">
  <data key="d0">European Parliament, 2020</data>
  <data key="d1">paper</data>
  <data key="d2">2020 European Parliament document. It recognizes that AI systems' reliance on inferred data creates tensions with GDPR principles such as data minimization and purpose limitation.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-001</data>
  <data key="d4">Vol.13.No.7.13.pdf</data>
