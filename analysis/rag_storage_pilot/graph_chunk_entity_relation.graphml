<node id="Blockchain-Based Authentication">
  <data key="d0">Blockchain-Based Authentication</data>
  <data key="d1">methodology</data>
  <data key="d2">An authentication approach that uses blockchain. The cited works apply it to IoT, AODV routing, MANETs, VANETs and FANETs.</data>
  <data key="d3">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-021</data>
  <data key="d4">InfocomJ_2022_3_4_Khalfaoui.pdf</data>
