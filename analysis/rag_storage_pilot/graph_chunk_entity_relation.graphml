<edge source="Boruta Algorithm" target="Dataset 1">
  <data key="d7">1.0</data>
  <data key="d8">Boruta selected 7 out of 20 features in Dataset 1, improving F1-score from 85.01% to 88.47%.</data>
  <data key="d9">feature reduction,related_to</data>
