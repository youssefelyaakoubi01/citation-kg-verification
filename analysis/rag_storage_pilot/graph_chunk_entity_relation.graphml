<node id="Non-Maximum Suppression">
  <data key="d0">Non-Maximum Suppression</data>
  <data key="d1">methodology</data>
  <data key="d2">Step that thins edges by suppressing all gradient values except local maxima along the gradient direction.</data>
  <data key="d3">doc-5436254d7328f14e8f79864da9fef604-chunk-003</data>
