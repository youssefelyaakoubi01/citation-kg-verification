<node id="Connectivity Probability">
  <data key="d0">Connectivity Probability</data>
  <data key="d1">concept</data>
  <data key="d2">Likelihood that vehicular network nodes stay connected. It is studied for VANETs under adverse weather conditions at 5.9 GHz.</data>
  <data key="d3">doc-db5423cfc6b0239a805a929baa02d1e9-chunk-013</data>
  <data key="d4">10.2478_acss-2022-0011.pdf</data>
  <data key="d5">1791421303</data>
  <data key="d6"></data>
</node>
<node id="Roadside Sensors">
  <data key="d0">Roadside Sensors</data>
  <data key="d1">concept</data>
  <data key="d2">Sensors deployed along roads. They serve as the basis of a route monitoring and warning system in VANET.</data>
  <data key="d3">doc-db5423cfc6b0239a805a929baa02d1e9-chunk-013</data>
  <data key="d4">10.2478_acss-2022-0011.pdf</data>
