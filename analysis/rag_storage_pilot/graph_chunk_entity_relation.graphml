<node id="FIPS 186-5">
  <data key="d0">FIPS 186-5</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as [37]. Standard that specifies ECDSA (P-256).</data>
  <data key="d3">doc-3cdf7983d59d3aabda65b170e48426b0-chunk-008</data>
  <data key="d4">Toward_Quantum-Safe_Permissioned_Blockchains_Evalu.pdf</data>
