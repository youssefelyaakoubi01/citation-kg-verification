  <data key="d13"></data>
</edge>
<edge source="Block-Size Overhead" target="SignDocument">
  <data key="d7">1.0</data>
  <data key="d8">SignDocument transactions cause the 1.48x block-size overhead by storing 3,309-byte signatures and 1,952-byte public keys.</data>
  <data key="d9">addresses,storage cost</data>
