<node id="Harmonic Mean">
  <data key="d0">Harmonic Mean</data>
  <data key="d1">concept</data>
  <data key="d2">Mean that is favored for ratios such as precision and recall because it balances extreme values more effectively than the arithmetic mean. It is used to define the F1-score.&lt;SEP&gt;A type of mean preferred for ratios such as precision and recall because it balances extreme values better than the arithmetic mean. The F1-Score is defined as the harmonic mean of precision and recall.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-007&lt;SEP&gt;doc-5436254d7328f14e8f79864da9fef604-chunk-004</data>
  <data key="d4">document.pdf&lt;SEP&gt;MVML_120 (1).pdf</data>
  <data key="d5">1791467113</data>
  <data key="d6"></data>
</node>
<node id="True Positive">
  <data key="d0">True Positive</data>
  <data key="d1">concept</data>
  <data key="d2">Confusion matrix outcome: the number of instances where the model's positive prediction matches the actual positive outcome.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-007</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425064</data>
  <data key="d6"></data>
</node>
<node id="False Positive">
  <data key="d0">False Positive</data>
  <data key="d1">concept</data>
  <data key="d2">Confusion matrix outcome: instances where the model predicts the positive class but the actual class is negative.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-007</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425064</data>
  <data key="d6"></data>
</node>
<node id="True Negative">
  <data key="d0">True Negative</data>
  <data key="d1">concept</data>
  <data key="d2">Confusion matrix outcome: instances where the model correctly predicts the negative class.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-007</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425064</data>
  <data key="d6"></data>
</node>
<node id="False Negative">
  <data key="d0">False Negative</data>
  <data key="d1">concept</data>
  <data key="d2">Confusion matrix outcome: instances where the model predicts the negative class but the actual class is positive.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-007</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425064</data>
  <data key="d6"></data>
