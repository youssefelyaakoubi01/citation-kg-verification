</node>
<node id="Pluggable Consensus Architecture">
  <data key="d0">Pluggable Consensus Architecture</data>
  <data key="d1">concept</data>
  <data key="d2">Key Hyperledger Fabric feature letting users select a consensus mechanism by fault tolerance and consistency needs.</data>
  <data key="d3">doc-dfeceae54500e0aef047f46e66c1451b-chunk-001</data>
