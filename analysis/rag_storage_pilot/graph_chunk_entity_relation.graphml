<node id="Hyperledger Fabric processes transactions through an execute-order-validate pipeline">
  <data key="d0">Hyperledger Fabric processes transactions through an execute-order-validate pipeline</data>
  <data key="d1">claim</data>
  <data key="d2">Statement made in the text: "Hyperledger Fabric processes transactions through a three-phase pipeline known as execute–order–validate [1]."</data>
  <data key="d3">doc-3cdf7983d59d3aabda65b170e48426b0-chunk-006</data>
