<node id="Access Token">
  <data key="d0">Access Token</data>
  <data key="d1">concept</data>
  <data key="d2">Token calculated by the smart contract in the proposed system and used to authenticate registered devices.&lt;SEP&gt;Token calculated by the smart contract and used to authenticate registered devices in the proposed decentralized mechanism.&lt;SEP&gt;Token calculated by the smart contract in the proposed decentralized authentication approach to authenticate devices.</data>
  <data key="d3">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-002&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-003&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-004</data>
