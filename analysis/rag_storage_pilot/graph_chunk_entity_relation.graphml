</node>
<node id="Ref [69]">
  <data key="d0">Ref [69]</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as [69] for heavier vehicles having longer stopping distances.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-005</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501134</data>
  <data key="d6"></data>
</node>
<node id="Ref [70]">
  <data key="d0">Ref [70]</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as [70] for heavier vehicles having longer stopping distances.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-005</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501134</data>
  <data key="d6"></data>
</node>
<node id="Ref [71]">
  <data key="d0">Ref [71]</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as [71] regarding the impracticality of expert elicitation for very large numbers of conditional probabilities.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-005</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
