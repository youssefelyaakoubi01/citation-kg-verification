  <data key="d0">Canny Filter</data>
  <data key="d1">methodology</data>
  <data key="d2">Edge detection filter applied to the collected images.&lt;SEP&gt;Edge detection filter used to extract edge characteristics from images; also referred to as Canny Edge Detection.</data>
  <data key="d3">doc-5436254d7328f14e8f79864da9fef604-chunk-000&lt;SEP&gt;doc-5436254d7328f14e8f79864da9fef604-chunk-002</data>
