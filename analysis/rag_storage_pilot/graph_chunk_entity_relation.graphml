  <data key="d0">10.33168/jliss.2026.0713</data>
  <data key="d1">identifier</data>
  <data key="d2">DOI of the paper.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-000</data>
  <data key="d4">Vol.13.No.7.13.pdf</data>
  <data key="d5">1791501852</data>
  <data key="d6"></data>
</node>
<node id="Specification-Driven Synthetic Data Generation Framework">
  <data key="d0">Specification-Driven Synthetic Data Generation Framework</data>
  <data key="d1">methodology</data>
  <data key="d2">Configurable framework using a parameter file (variables, admissible values or intervals, target percentages) and a conditions file (forbidden combinations as logical rules) to generate synthetic tabular data at scale.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-000</data>
  <data key="d4">Vol.13.No.7.13.pdf</data>
  <data key="d5">1791501852</data>
  <data key="d6"></data>
</node>
