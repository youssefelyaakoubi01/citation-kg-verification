  <data key="d11">MVML_120 (1).pdf</data>
  <data key="d12">1791467205</data>
  <data key="d13"></data>
</edge>
<edge source="Ha et al. (2021)" target="Canny filter with CNN achieves high accuracy in defect detection">
  <data key="d7">1.0</data>
  <data key="d8">Reports around 93% accuracy with CNN and edge detection for injection molding.</data>
  <data key="d9">supports</data>
  <data key="d10">doc-5436254d7328f14e8f79864da9fef604-chunk-006</data>
