  <data key="d6"></data>
</node>
<node id="Random Forest is more accurate than linear regression for driver musculoskeletal discomfort">
  <data key="d0">Random Forest is more accurate than linear regression for driver musculoskeletal discomfort</data>
  <data key="d1">claim</data>
  <data key="d2">Statement in the text: "The results demonstrated increased accuracy for the Random Forest method compared to linear regression."</data>
  <data key="d3">doc-c6cf0e7751b1667f02411ba9fa2e2995-chunk-001</data>
