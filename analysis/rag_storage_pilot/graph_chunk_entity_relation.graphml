<node id="Xu et al., 2019">
  <data key="d0">Xu et al., 2019</data>
  <data key="d1">paper</data>
  <data key="d2">Work by Xu et al. (2019) that proposed CTGAN, a Conditional Tabular GAN. CTGAN uses conditional sampling for rare categories and mode-specific normalization for continuous variables, and outperformed Bayesian baselines and earlier GAN/VAE models.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-001</data>
  <data key="d4">Vol.13.No.7.13.pdf</data>
  <data key="d5">1791501852</data>
  <data key="d6"></data>
</node>
<node id="Parise et al., 2025">
  <data key="d0">Parise et al., 2025</data>
  <data key="d1">paper</data>
  <data key="d2">Cited work (2025) that extends or adapts CTGAN for domain-specific uses.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-001</data>
  <data key="d4">Vol.13.No.7.13.pdf</data>
  <data key="d5">1791501852</data>
  <data key="d6"></data>
</node>
