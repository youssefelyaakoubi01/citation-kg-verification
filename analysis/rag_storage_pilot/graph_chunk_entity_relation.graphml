  <data key="d6"></data>
</node>
<node id="Mankosi Community Tribal Government">
  <data key="d0">Mankosi Community Tribal Government</data>
  <data key="d1">organization</data>
  <data key="d2">Tribal government of the Mankosi community in South Africa. It co-founded the Zenzeleni community network in 2013 with PhD students from the University of the Western Cape.</data>
  <data key="d3">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-000</data>
  <data key="d4">InfocomJ_2022_3_4_Khalfaoui.pdf</data>
