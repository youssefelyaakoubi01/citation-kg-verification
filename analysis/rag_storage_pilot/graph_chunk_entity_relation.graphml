  <data key="d0">Polypropylene (PP)</data>
  <data key="d1">concept</data>
  <data key="d2">One of the plastic material types included in the material_data of the dataset.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-004</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425063</data>
  <data key="d6"></data>
