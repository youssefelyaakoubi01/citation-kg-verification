<node id="Quantum Threats">
  <data key="d0">Quantum Threats</data>
  <data key="d1">concept</data>
  <data key="d2">Threats posed by quantum computing to classical cryptography. Blockchain platforms must prepare for them.</data>
  <data key="d3">doc-3cdf7983d59d3aabda65b170e48426b0-chunk-005</data>
