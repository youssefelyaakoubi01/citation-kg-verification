<node id="Gaussian Membership Function Produces Less Inaccuracy">
  <data key="d0">Gaussian Membership Function Produces Less Inaccuracy</data>
  <data key="d1">claim</data>
  <data key="d2">Statement made in the text: "Gaussian is the membership function that is utilized for each node in the graph since it produces less inaccuracy than other triangle and trapezoidal functions [96]."</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-008</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
