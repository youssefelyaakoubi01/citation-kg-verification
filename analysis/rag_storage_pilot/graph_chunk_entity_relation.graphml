  <data key="d0">Molding Adjuster</data>
  <data key="d1">other</data>
  <data key="d2">Role responsible for allocating machines based on part design, mold design, material specifications, and customer demand.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-002</data>
