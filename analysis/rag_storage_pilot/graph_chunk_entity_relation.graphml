  <data key="d0">Cloud Integration</data>
  <data key="d1">concept</data>
  <data key="d2">Component of the Digital Twin framework for injection molding.</data>
  <data key="d3">doc-b861a9335e2f8bb52dad6132b0acac1d-chunk-005</data>
