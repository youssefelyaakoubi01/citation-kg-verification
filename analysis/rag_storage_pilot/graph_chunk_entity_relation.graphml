<node id="Hybrid Digital Signatures">
  <data key="d0">Hybrid Digital Signatures</data>
  <data key="d1">concept</data>
  <data key="d2">Signature schemes that combine classical and post-quantum signatures, such as the ML-DSA-65/ECDSA combination studied in the paper.</data>
  <data key="d3">doc-3cdf7983d59d3aabda65b170e48426b0-chunk-000</data>
  <data key="d4">Toward_Quantum-Safe_Permissioned_Blockchains_Evalu.pdf</data>
