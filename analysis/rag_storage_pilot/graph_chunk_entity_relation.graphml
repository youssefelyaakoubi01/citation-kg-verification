  <data key="d6"></data>
</node>
<node id="Laravel">
  <data key="d0">Laravel</data>
  <data key="d1">methodology</data>
  <data key="d2">Widely used PHP framework for building web applications.&lt;SEP&gt;Widely used PHP framework for building web applications; target of the UML-to-Laravel code transformation in [19].</data>
  <data key="d3">doc-a4aa31c8531fdbc66868e8d96c0e0d18-chunk-002&lt;SEP&gt;doc-a4aa31c8531fdbc66868e8d96c0e0d18-chunk-003</data>
  <data key="d4">Microservices-Driven_Automation_in_Full-Stack_Deve.pdf</data>
