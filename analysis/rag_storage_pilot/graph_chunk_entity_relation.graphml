<node id="Margin Maximization">
  <data key="d0">Margin Maximization</data>
  <data key="d1">concept</data>
  <data key="d2">SVM principle of maximizing the margin between classes so that they separate effectively. It is rooted in statistical principles.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-007</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425064</data>
  <data key="d6"></data>
</node>
<node id="Cost Function">
  <data key="d0">Cost Function</data>
  <data key="d1">concept</data>
  <data key="d2">Function whose minimization SGD uses to find parameter values.</data>
