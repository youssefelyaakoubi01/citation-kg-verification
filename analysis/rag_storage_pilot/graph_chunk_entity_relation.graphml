  <data key="d0">Ethereum Blockchain</data>
  <data key="d1">methodology</data>
  <data key="d2">Blockchain platform managed by smart contract rules used in the proposed authentication architecture.</data>
  <data key="d3">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-002</data>
