  <data key="d1">concept</data>
  <data key="d2">Systematic decision-making process enabled by applying classification algorithms to machine selection.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-006</data>
  <data key="d4">document.pdf</data>
