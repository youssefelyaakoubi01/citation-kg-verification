<node id="Text Mining">
  <data key="d0">Text Mining</data>
  <data key="d1">methodology</data>
  <data key="d2">Technique used by Pejic-Bach et al. (2020) to analyze publicly available Industry 4.0 job advertisements and develop two knowledge-based profiles.&lt;SEP&gt;Technique used by Li, Yu and Wen (2019) to predict automobile sales from online search keywords.</data>
  <data key="d3">doc-7f659f89172b81a0adff01963801bdcb-chunk-006&lt;SEP&gt;doc-4e26e4b19a21a1bf5f3daec0bcb0830c-chunk-009</data>
