<node id="Xiahou and Harada [17]">
  <data key="d0">Xiahou and Harada [17]</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as [17]. Proposes a customer churn prediction model for B2C e-commerce combining k-means customer segmentation with SVM prediction; finds segmentation significantly improves accuracy and SVM outperforms LR.</data>
  <data key="d3">doc-3b6de35b4fc6654223999680ef1082ec-chunk-002</data>
