  <data key="d1">methodology</data>
  <data key="d2">Baseline generation strategy implemented by the framework.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-000</data>
  <data key="d4">Vol.13.No.7.13.pdf</data>
  <data key="d5">1791501852</data>
  <data key="d6"></data>
