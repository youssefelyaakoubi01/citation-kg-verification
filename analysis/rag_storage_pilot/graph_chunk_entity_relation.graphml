</node>
<node id="Author productivity in feature selection follows Lotka's law">
  <data key="d0">Author productivity in feature selection follows Lotka's law</data>
  <data key="d1">claim</data>
  <data key="d2">Statement made in the text: "The observed distribution follows Lotka's law, indicating that a minority of authors contribute a disproportionately large number of studies."</data>
  <data key="d3">doc-7b9912ddab6105f96b8cd8cb51d46ee9-chunk-003</data>
  <data key="d4">A_bibliometric_analysis_of_feature_selection_techn.pdf</data>
  <data key="d5">1791422137</data>
  <data key="d6"></data>
</node>
<node id="Highly cited feature selection papers play a foundational role">
  <data key="d0">Highly cited feature selection papers play a foundational role</data>
  <data key="d1">claim</data>
  <data key="d2">Statement made in the text: "Although most of these papers are not among the most recent, their consistently high citation rates underscore their foundational role and ongoing relevance in the development of feature selection methodologies."</data>
  <data key="d3">doc-7b9912ddab6105f96b8cd8cb51d46ee9-chunk-003</data>
  <data key="d4">A_bibliometric_analysis_of_feature_selection_techn.pdf</data>
