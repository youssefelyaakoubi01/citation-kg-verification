  <data key="d7">1.0</data>
  <data key="d8">The paper collects and analyzes 13 years of daily sales from a USA superstore.</data>
  <data key="d9">data collection,uses_dataset</data>
  <data key="d10">doc-285b07b80137f799fd1205a24fb418c4-chunk-001</data>
