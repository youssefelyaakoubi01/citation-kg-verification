  <data key="d0">Azees</data>
  <data key="d1">author</data>
  <data key="d2">First author of the anonymous blockchain-based authentication mechanism for VANET [14].&lt;SEP&gt;First author of the blockchain-based anonymous authentication mechanism for VANET [14].</data>
  <data key="d3">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-006&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-007</data>
