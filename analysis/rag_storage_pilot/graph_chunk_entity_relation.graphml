  <data key="d1">methodology</data>
  <data key="d2">Design pattern used to optimize management of critical services such as MongoDB, Redis and RabbitMQ.</data>
  <data key="d3">doc-a4aa31c8531fdbc66868e8d96c0e0d18-chunk-013</data>
