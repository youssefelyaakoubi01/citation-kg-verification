<node id="Internet of Manufacturing Things">
  <data key="d0">Internet of Manufacturing Things</data>
  <data key="d1">concept</data>
  <data key="d2">Domain including deep learning-assisted smart process planning, robotic wireless sensor networks and geospatial big data management.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-003</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425063</data>
  <data key="d6"></data>
</node>
<node id="Cognitive Manufacturing">
  <data key="d0">Cognitive Manufacturing</data>
  <data key="d1">concept</data>
  <data key="d2">Big data-driven manufacturing involving AI-based decision-making, IoT sensing networks and sustainable cyber-physical management systems.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-003</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425063</data>
