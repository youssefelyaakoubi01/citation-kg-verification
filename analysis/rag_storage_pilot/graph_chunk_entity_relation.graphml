  <data key="d0">SMART</data>
  <data key="d1">methodology</data>
  <data key="d2">Simple Multi-Attribute Rating Technique, a subjective criteria-weighting approach.</data>
  <data key="d3">doc-54e26c32a6c6377d00b93d14e0ea3092-chunk-001</data>
