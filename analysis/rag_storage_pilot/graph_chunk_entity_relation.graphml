<node id="An Improved Self-Training Network for Building and Road Extraction in Urban Areas by Integrating Optical and Radar Remotely Sensed Data">
  <data key="d0">An Improved Self-Training Network for Building and Road Extraction in Urban Areas by Integrating Optical and Radar Remotely Sensed Data</data>
  <data key="d1">paper</data>
