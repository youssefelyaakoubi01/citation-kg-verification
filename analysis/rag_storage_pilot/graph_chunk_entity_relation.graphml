<node id="Time Series Generation">
  <data key="d0">Time Series Generation</data>
  <data key="d1">concept</data>
  <data key="d2">Problem of generating synthetic time series, addressed by TimeGAN, COSCI-GAN and Sig-Wasserstein GANs.</data>
  <data key="d3">doc-ed200d7fb9035c5336533a6730c8671b-chunk-012</data>
  <data key="d4">GANsinsyntheticfinancialdata_donalsonwilson_versionpublie.pdf</data>
