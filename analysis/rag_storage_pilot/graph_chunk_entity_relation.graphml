  <data key="d12">1791466863</data>
  <data key="d13"></data>
</edge>
<edge source="Blockchain" target="Miners">
  <data key="d7">4.0</data>
  <data key="d8">Miners are active blockchain nodes that validate blocks and are rewarded.&lt;SEP&gt;Miners are active nodes that validate blocks using a consensus procedure and are rewarded.&lt;SEP&gt;Miners validate blocks of transactions and are rewarded, after which the blockchain stores the verified block.&lt;SEP&gt;In blockchain, active nodes known as miners validate blocks before they are stored.</data>
  <data key="d9">block validation,related_to</data>
  <data key="d10">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-003&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-004&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-005&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-006</data>
  <data key="d11">InfocomJ_2022_3_4_Khalfaoui.pdf</data>
  <data key="d12">1791466863</data>
  <data key="d13"></data>
</edge>
