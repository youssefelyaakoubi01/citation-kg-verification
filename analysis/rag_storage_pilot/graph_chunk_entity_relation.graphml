  <data key="d13"></data>
</edge>
<edge source="Forget Gate" target="Sigmoid Activation Function">
  <data key="d7">2.0</data>
  <data key="d8">The forget gate processes input and previous hidden state through a sigmoid activation function.&lt;SEP&gt;The forget gate output f_t is computed through a sigmoid activation function.</data>
  <data key="d9">activation,related_to</data>
  <data key="d10">doc-b861a9335e2f8bb52dad6132b0acac1d-chunk-002&lt;SEP&gt;doc-1920bb99aa33c3c871f9dc257956e3ca-chunk-009</data>
