<node id="V2I Communication">
  <data key="d0">V2I Communication</data>
  <data key="d1">concept</data>
  <data key="d2">Vehicle-to-infrastructure communication, one part of the data exchanged with the OBU.</data>
  <data key="d3">doc-db5423cfc6b0239a805a929baa02d1e9-chunk-005</data>
