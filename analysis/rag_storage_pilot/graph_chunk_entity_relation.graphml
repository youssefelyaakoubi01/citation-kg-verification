<node id="Injection Mold Dataset">
  <data key="d0">Injection Mold Dataset</data>
  <data key="d1">dataset</data>
  <data key="d2">Moderate-sized dataset of molds and parts with features such as material flow rate, material type and machine clamping force. 83 samples were used for training and 21 for testing.</data>
  <data key="d3">doc-5f0352d149ce07cb8b4fdf8db0076c7d-chunk-002</data>
