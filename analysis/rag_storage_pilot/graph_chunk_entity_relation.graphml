  <data key="d12">1791426515</data>
  <data key="d13"></data>
</edge>
<edge source="HAIT 320T" target="Sensitivity Verification">
  <data key="d7">1.0</data>
  <data key="d8">The sensitivity verification adjusts the three main weights associated with HAIT 320T.</data>
  <data key="d9">related_to,weight adjustment</data>
  <data key="d10">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-009</data>
  <data key="d11">IJE_Volume38_Issue2_Pages488-502_Versionfinale.pdf</data>
  <data key="d12">1791426515</data>
  <data key="d13"></data>
</edge>
<edge source="HAIT 320T" target="Scenario 1">
  <data key="d7">1.0</data>
  <data key="d8">In Scenario 1, the rank of HAIT 320T becomes closely aligned with ARB 200T, about 42% far from the worst solution.</data>
  <data key="d9">ranking change,related_to</data>
  <data key="d10">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-010</data>
  <data key="d11">IJE_Volume38_Issue2_Pages488-502_Versionfinale.pdf</data>
  <data key="d12">1791426515</data>
  <data key="d13"></data>
</edge>
<edge source="HAIT 320T" target="Scrap Rate">
  <data key="d7">1.0</data>
  <data key="d8">HAIT 320T has an initial scrap rate of 0.60%. This value is improved to 0.40% in Scenarios 1 and 3.</data>
  <data key="d9">criterion value,related_to</data>
  <data key="d10">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-010</data>
  <data key="d11">IJE_Volume38_Issue2_Pages488-502_Versionfinale.pdf</data>
  <data key="d12">1791426515</data>
  <data key="d13"></data>
</edge>
<edge source="Initial Decision Matrix" target="TOPSIS Assessment Scale">
  <data key="d7">1.0</data>
  <data key="d8">Each criterion in the initial decision matrix is rated using the TOPSIS assessment scale listed in Table 9.</data>
  <data key="d9">rating scale,related_to</data>
  <data key="d10">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-008</data>
  <data key="d11">IJE_Volume38_Issue2_Pages488-502_Versionfinale.pdf</data>
  <data key="d12">1791426515</data>
  <data key="d13"></data>
</edge>
<edge source="Separation Measure" target="Relative Closeness Ranking">
  <data key="d7">1.0</data>
  <data key="d8">The separation values S+ and S- are combined to compute the ranking score S_i.</data>
  <data key="d9">computation step,related_to</data>
  <data key="d10">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-009</data>
  <data key="d11">IJE_Volume38_Issue2_Pages488-502_Versionfinale.pdf</data>
  <data key="d12">1791426515</data>
  <data key="d13"></data>
</edge>
<edge source="Scenario 1" target="Scrap Rate">
  <data key="d7">1.0</data>
  <data key="d8">Scenario 1 improves the scrap rate by 0.2%.</data>
  <data key="d9">addresses,improvement</data>
  <data key="d10">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-010</data>
  <data key="d11">IJE_Volume38_Issue2_Pages488-502_Versionfinale.pdf</data>
  <data key="d12">1791426515</data>
  <data key="d13"></data>
</edge>
<edge source="Scenario 3" target="Scrap Rate">
  <data key="d7">1.0</data>
  <data key="d8">Scenario 3 improves the scrap rate by 0.2% alongside the breakdown rate.</data>
  <data key="d9">addresses,combined improvement</data>
  <data key="d10">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-010</data>
  <data key="d11">IJE_Volume38_Issue2_Pages488-502_Versionfinale.pdf</data>
  <data key="d12">1791426515</data>
  <data key="d13"></data>
</edge>
<edge source="Rankings are sensitive to scrap rate and breakdown rate improvements" target="Scrap Rate">
  <data key="d7">1.0</data>
  <data key="d8">The finding concerns a 0.2% scrap rate improvement.</data>
  <data key="d9">addresses</data>
  <data key="d10">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-011</data>
