  <data key="d0">Injection Unit Validation</data>
  <data key="d1">methodology</data>
  <data key="d2">Phase validating the injection unit, including screw and barrel specifications, injection pressure, and capacity to meet production rate.&lt;SEP&gt;Final phase checking material, dosing volume, part weight, screw type, maximum injection pressure and maximum production rate.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-002&lt;SEP&gt;doc-467b87e0a1eaa0377cb70477245debc3-chunk-003</data>
