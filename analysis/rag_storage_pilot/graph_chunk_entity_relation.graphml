</node>
<node id="Ref (31) PROMETHEE">
  <data key="d0">Ref (31) PROMETHEE</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as (31) for PROMETHEE.</data>
  <data key="d3">doc-690b1785f1cbb35b37a4dcdbae1984e4-chunk-003</data>
