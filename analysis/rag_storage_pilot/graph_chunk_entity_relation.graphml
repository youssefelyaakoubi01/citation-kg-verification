<node id="Rivest Shamir Adleman (RSA)">
  <data key="d0">Rivest Shamir Adleman (RSA)</data>
  <data key="d1">methodology</data>
  <data key="d2">Public-key algorithm compared with ECC in terms of security level.</data>
  <data key="d3">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-017</data>
  <data key="d4">InfocomJ_2022_3_4_Khalfaoui.pdf</data>
