</node>
<node id="Liu et al. 2021">
  <data key="d0">Liu et al. 2021</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as [8]. Tackles automatic appearance defect detection in manufacturing. It proposes a knowledge reuse strategy to train CNN models using transfer learning and data augmentation.</data>
  <data key="d3">doc-5436254d7328f14e8f79864da9fef604-chunk-000</data>
  <data key="d4">MVML_120 (1).pdf</data>
  <data key="d5">1791467085</data>
  <data key="d6"></data>
</node>
