<node id="Mühlhoff, 2023">
  <data key="d0">Mühlhoff, 2023</data>
  <data key="d1">paper</data>
  <data key="d2">Work by Mühlhoff (2023) that introduced the notion of predictive privacy. It argues that models inferring sensitive traits can violate privacy even when data is anonymized.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-001</data>
  <data key="d4">Vol.13.No.7.13.pdf</data>
