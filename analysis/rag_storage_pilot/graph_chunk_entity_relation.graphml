<node id="Preventive Maintenance">
  <data key="d0">Preventive Maintenance</data>
  <data key="d1">concept</data>
  <data key="d2">Maintenance scheduled at regular intervals.</data>
  <data key="d3">doc-eafe46d984faf5ae72cd0cf550c6ec66-chunk-000</data>
