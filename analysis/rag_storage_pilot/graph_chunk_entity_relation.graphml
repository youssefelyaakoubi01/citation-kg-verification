  <data key="d2">First author of the 2023 paper on factors affecting marine accident severity using a data-driven Bayesian network.&lt;SEP&gt;Co-author of references [40], [41] and [42].</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-020&lt;SEP&gt;doc-3cdf7983d59d3aabda65b170e48426b0-chunk-041</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf&lt;SEP&gt;Toward_Quantum-Safe_Permissioned_Blockchains_Evalu.pdf</data>
  <data key="d5">1791502220</data>
  <data key="d6"></data>
</node>
<node id="Type-2 Fuzzy Neural Network">
  <data key="d0">Type-2 Fuzzy Neural Network</data>
  <data key="d1">methodology</data>
  <data key="d2">A neural network architecture based on type-2 fuzzy logic.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-020</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501144</data>
  <data key="d6"></data>
</node>
<node id="PSO-DE">
  <data key="d0">PSO-DE</data>
  <data key="d1">methodology</data>
  <data key="d2">A series hybrid of particle swarm optimization and differential evolution. It is used with time-varying Gaussian membership function based fuzzy selection for wind-integrated optimal dispatch.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-020</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501144</data>
  <data key="d6"></data>
</node>
<node id="Fuzzy-Bayesian Network">
  <data key="d0">Fuzzy-Bayesian Network</data>
  <data key="d1">methodology</data>
  <data key="d2">A combination of fuzzy logic and Bayesian networks. It is applied to ship steering gear failure risk assessment and to container liner bankruptcy causes.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-020</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501144</data>
  <data key="d6"></data>
</node>
<node id="FMEA">
  <data key="d0">FMEA</data>
  <data key="d1">methodology</data>
  <data key="d2">Failure Mode and Effects Analysis. A Bayesian-network-driven variant is used to assess maritime cybersecurity risks.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-020</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501144</data>
  <data key="d6"></data>
</node>
<node id="Dynamic Bayesian Network">
  <data key="d0">Dynamic Bayesian Network</data>
  <data key="d1">methodology</data>
  <data key="d2">A time-extended Bayesian network. It is used with the NK model for risk coupling analysis of subsea blowout accidents.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-020</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501144</data>
  <data key="d6"></data>
</node>
<node id="NK Model">
  <data key="d0">NK Model</data>
  <data key="d1">methodology</data>
  <data key="d2">A model used with a dynamic Bayesian network to analyze risk coupling in subsea blowout accidents.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-020</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501144</data>
  <data key="d6"></data>
</node>
<node id="FinFET Technology">
  <data key="d0">FinFET Technology</data>
  <data key="d1">methodology</data>
  <data key="d2">A transistor technology. It is used to build a high-performance, ultra-efficient programmable fuzzy membership function generator for image enhancement.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-020</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501144</data>
  <data key="d6"></data>
</node>
<node id="Development of a Blockchain Solution for Vehicle Management within a Consortium using Hyperledger Fabric">
  <data key="d0">Development of a Blockchain Solution for Vehicle Management within a Consortium using Hyperledger Fabric</data>
  <data key="d1">paper</data>
  <data key="d2">Poster presented at the 7th edition of the International Conference AI2SD'2025 (Tangier, Morocco, 21-23 May 2025). It describes the design and deployment of a blockchain-based system for managing vehicle information within a multi-party consortium using the permissioned Hyperledger Fabric framework, integrating connected vehicles and user applications via a secure API Gateway and smart contracts.</data>
  <data key="d3">doc-26549e3ff493405b55b221c1d804516e-chunk-000</data>
