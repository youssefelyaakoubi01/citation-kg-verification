  <data key="d6"></data>
</node>
<node id="Shannon">
  <data key="d0">Shannon</data>
  <data key="d1">author</data>
  <data key="d2">Author of the 1948 work, cited as [7], that adapted the entropy concept to measure uncertainty in information sources. This adaptation became known as information entropy.&lt;SEP&gt;Author of the 1948 work cited as [7], which adapted entropy to measure uncertainty in information sources.</data>
  <data key="d3">doc-54e26c32a6c6377d00b93d14e0ea3092-chunk-005&lt;SEP&gt;doc-54e26c32a6c6377d00b93d14e0ea3092-chunk-006</data>
