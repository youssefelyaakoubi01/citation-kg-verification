<node id="Kotelnikov et al., 2022">
  <data key="d0">Kotelnikov et al., 2022</data>
  <data key="d1">paper</data>
  <data key="d2">Work by Kotelnikov et al. (2022) that introduces TabDDPM, a diffusion model for mixed-type tabular data.</data>
  <data key="d3">doc-8a68f6918fb713b374b6980cb85c4169-chunk-001</data>
  <data key="d4">Vol.13.No.7.13.pdf</data>
