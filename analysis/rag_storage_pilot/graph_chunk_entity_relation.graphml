  <data key="d0">Blockchain Ledger</data>
  <data key="d1">methodology</data>
  <data key="d2">Distributed ledger on which vehicle registration, maintenance and ownership data, validated by smart contracts, are recorded, ensuring transparency, traceability and data integrity.</data>
  <data key="d3">doc-26549e3ff493405b55b221c1d804516e-chunk-001</data>
  <data key="d4">poster_nihad.pdf</data>
  <data key="d5">1791501149</data>
  <data key="d6"></data>
</node>
<node id="Private Data Exchange">
  <data key="d0">Private Data Exchange</data>
  <data key="d1">concept</data>
  <data key="d2">Capability for confidential data sharing between parties, supported by Hyperledger Fabric and used to enable secure and private transactions among multiple parties.</data>
  <data key="d3">doc-26549e3ff493405b55b221c1d804516e-chunk-001</data>
  <data key="d4">poster_nihad.pdf</data>
  <data key="d5">1791501149</data>
  <data key="d6"></data>
</node>
<node id="Data Traceability">
  <data key="d0">Data Traceability</data>
  <data key="d1">concept</data>
  <data key="d2">Ability to trace data history and provenance; blockchain is described as enhancing trust and data traceability, and the proposed architecture ensures traceability of vehicle data.</data>
  <data key="d3">doc-26549e3ff493405b55b221c1d804516e-chunk-001</data>
  <data key="d4">poster_nihad.pdf</data>
