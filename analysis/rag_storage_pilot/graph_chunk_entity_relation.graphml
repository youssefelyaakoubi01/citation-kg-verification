  <data key="d3">doc-ed200d7fb9035c5336533a6730c8671b-chunk-000&lt;SEP&gt;doc-ed200d7fb9035c5336533a6730c8671b-chunk-008</data>
  <data key="d4">GANsinsyntheticfinancialdata_donalsonwilson_versionpublie.pdf</data>
