<node id="Shi et al. [18]">
  <data key="d0">Shi et al. [18]</data>
  <data key="d1">paper</data>
  <data key="d2">Cited as [18]. Proposes and assesses a machine learning classification model for predicting customer churn using e-commerce customer data; the decision tree algorithm is most effective.</data>
  <data key="d3">doc-3b6de35b4fc6654223999680ef1082ec-chunk-002</data>
  <data key="d4">25293-55764-1-PB.pdf</data>
