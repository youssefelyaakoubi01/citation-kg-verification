  <data key="d12">1791467205</data>
  <data key="d13"></data>
</edge>
<edge source="Blockchain" target="Proof of Work">
  <data key="d7">3.0</data>
  <data key="d8">Miners validate blocks using consensus such as Proof of Work.&lt;SEP&gt;Miners validate blocks using a consensus procedure like PoW.&lt;SEP&gt;Miners validate blocks using consensus procedures such as PoW.</data>
  <data key="d9">consensus,related_to,uses_method</data>
  <data key="d10">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-003&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-005&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-006</data>
  <data key="d11">InfocomJ_2022_3_4_Khalfaoui.pdf</data>
  <data key="d12">1791466863</data>
  <data key="d13"></data>
</edge>
<edge source="Blockchain" target="Decentralized Authentication">
  <data key="d7">2.0</data>
  <data key="d8">Decentralized authentication is realized through blockchain.&lt;SEP&gt;The decentralized authentication approach relies on blockchain for device registration and authentication.</data>
  <data key="d9">enabling technology,related_to</data>
  <data key="d10">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-003&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-005</data>
