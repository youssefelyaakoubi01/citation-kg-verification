  <data key="d0">Physical Vehicle Condition</data>
  <data key="d1">concept</data>
  <data key="d2">Bayesian network node 3 with linguistic values Good, Medium, Bad.&lt;SEP&gt;Node of the Bayesian network modeling road accident risk. It is used as an input in the example fuzzy rules.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-006&lt;SEP&gt;doc-a503621d914a716d7d3a5232c23b6bc6-chunk-007</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501134</data>
  <data key="d6"></data>
</node>
<node id="Road Design">
  <data key="d0">Road Design</data>
  <data key="d1">concept</data>
  <data key="d2">Bayesian network node 5 with linguistic values Save, Critical, Dangerous.&lt;SEP&gt;Node of the Bayesian network modeling road accident risk.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-006&lt;SEP&gt;doc-a503621d914a716d7d3a5232c23b6bc6-chunk-007</data>
  <data key="d4">Paper_101-Enhancing_Predictive_Analysis_of_Vehicle_Accident_Risk.pdf</data>
  <data key="d5">1791501134</data>
  <data key="d6"></data>
</node>
<node id="Traffic Flow">
  <data key="d0">Traffic Flow</data>
  <data key="d1">concept</data>
  <data key="d2">Bayesian network node 7 with linguistic values Smooth, Congested, Stop-and-go.&lt;SEP&gt;Node of the Bayesian network modeling road accident risk.</data>
  <data key="d3">doc-a503621d914a716d7d3a5232c23b6bc6-chunk-006&lt;SEP&gt;doc-a503621d914a716d7d3a5232c23b6bc6-chunk-007</data>
