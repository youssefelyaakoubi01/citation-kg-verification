  <data key="d5">1791501527</data>
  <data key="d6"></data>
</node>
<node id="Attacks">
  <data key="d0">Attacks</data>
  <data key="d1">concept</data>
  <data key="d2">Intermediate effect in the causal graph. It is the number of attacks launched in the network.</data>
  <data key="d3">doc-db5423cfc6b0239a805a929baa02d1e9-chunk-005</data>
