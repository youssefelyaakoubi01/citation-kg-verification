  <data key="d1">concept</data>
  <data key="d2">Tool in generated solutions supporting reporting and decision-making.&lt;SEP&gt;Tool included in generated solutions, alongside reporting and data import/export, facilitating decision-making and system integration.</data>
  <data key="d3">doc-a4aa31c8531fdbc66868e8d96c0e0d18-chunk-008&lt;SEP&gt;doc-a4aa31c8531fdbc66868e8d96c0e0d18-chunk-009</data>
  <data key="d4">Microservices-Driven_Automation_in_Full-Stack_Deve.pdf</data>
  <data key="d5">1791467649</data>
  <data key="d6"></data>
</node>
<node id="Data Import/Export">
