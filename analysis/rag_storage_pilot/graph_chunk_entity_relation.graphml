<node id="Quality of Data">
  <data key="d0">Quality of Data</data>
  <data key="d1">concept</data>
  <data key="d2">Final impact in the causal graph. It is determined by accuracy, completeness, confidentiality, validity, uniqueness and timeliness.</data>
  <data key="d3">doc-db5423cfc6b0239a805a929baa02d1e9-chunk-005</data>
