<node id="Co-Citation Analysis">
  <data key="d0">Co-Citation Analysis</data>
  <data key="d1">methodology</data>
  <data key="d2">Method evaluating relationships between cited documents and citing documents; two frequently co-cited papers likely cover related or complementary topics.</data>
  <data key="d3">doc-4e26e4b19a21a1bf5f3daec0bcb0830c-chunk-005</data>
