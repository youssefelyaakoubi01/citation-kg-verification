<edge source="FSMicroGenerator" target="Inventory Management System Case Study">
  <data key="d7">1.0</data>
  <data key="d8">FSMicroGenerator is evaluated on the inventory management system case study against a traditional manual approach.</data>
  <data key="d9">evaluation,related_to</data>
