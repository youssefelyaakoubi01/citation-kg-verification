  <data key="d5">1791466841</data>
  <data key="d6"></data>
</node>
<node id="Vehicle-to-Infrastructure Communication">
  <data key="d0">Vehicle-to-Infrastructure Communication</data>
  <data key="d1">concept</data>
  <data key="d2">V2I; a communication mode that VANET aims to support between vehicles and road infrastructure.</data>
  <data key="d3">doc-db5423cfc6b0239a805a929baa02d1e9-chunk-000</data>
  <data key="d4">10.2478_acss-2022-0011.pdf</data>
  <data key="d5">1791421303</data>
