  <data key="d0">Discriminative Learning</data>
  <data key="d1">concept</data>
  <data key="d2">Learning tasks involving linear classifiers, where SGD is widely applied.</data>
  <data key="d3">doc-467b87e0a1eaa0377cb70477245debc3-chunk-007</data>
  <data key="d4">document.pdf</data>
  <data key="d5">1791425064</data>
