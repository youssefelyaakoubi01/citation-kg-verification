<node id="OOM Errors">
  <data key="d0">OOM Errors</data>
  <data key="d1">concept</data>
  <data key="d2">Out-of-memory errors node with the values Low, Medium and High. It is related to GPU state.</data>
  <data key="d3">doc-eafe46d984faf5ae72cd0cf550c6ec66-chunk-006</data>
