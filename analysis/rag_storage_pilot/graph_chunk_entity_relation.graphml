  <data key="d1">concept</data>
  <data key="d2">Bayesian network node with the values Low, Normal and High.</data>
  <data key="d3">doc-eafe46d984faf5ae72cd0cf550c6ec66-chunk-006</data>
  <data key="d4">From_Uncertainty_to_Decision_An_Intelligent_Predic.pdf</data>
  <data key="d5">1791425298</data>
  <data key="d6"></data>
</node>
<node id="Disk Temperature">
  <data key="d0">Disk Temperature</data>
  <data key="d1">concept</data>
  <data key="d2">Bayesian network node with the values Normal, Warning and Critical. It is related to hard disk state.</data>
  <data key="d3">doc-eafe46d984faf5ae72cd0cf550c6ec66-chunk-006</data>
