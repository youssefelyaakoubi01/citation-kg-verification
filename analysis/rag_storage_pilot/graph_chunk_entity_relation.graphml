<node id="Mobile Ad hoc Network">
  <data key="d0">Mobile Ad hoc Network</data>
  <data key="d1">concept</data>
  <data key="d2">MANET; an open-environment network of resource-constrained devices for which current authentication solutions are inadequate.</data>
  <data key="d3">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-006</data>
  <data key="d4">InfocomJ_2022_3_4_Khalfaoui.pdf</data>
