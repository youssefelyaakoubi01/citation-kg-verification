</edge>
<edge source="Boruta Algorithm" target="Dataset 2">
  <data key="d7">1.0</data>
  <data key="d8">Boruta selected 15 out of 29 features in Dataset 2, improving F1-score from 28.10% to 33.33%.</data>
  <data key="d9">feature reduction,related_to</data>
  <data key="d10">doc-ed5a32c2476eb625d3377722542a5d95-chunk-004</data>
  <data key="d11">CIST_174.pdf</data>
