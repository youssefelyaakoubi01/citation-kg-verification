  <data key="d1">methodology</data>
  <data key="d2">Document embedding technique used for storage of chunks in the AI assistance model.</data>
  <data key="d3">doc-caa1a23d50101616a42f59c788898ea5-chunk-004</data>
  <data key="d4">Paper_113-Accurate_AI_Assistance_in_Contract_Law1.pdf</data>
  <data key="d5">1791500933</data>
  <data key="d6"></data>
</node>
<node id="Similarity Search">
  <data key="d0">Similarity Search</data>
  <data key="d1">methodology</data>
  <data key="d2">Search technique used to retrieve pertinent information from embedded documents.&lt;SEP&gt;Approximate and billion-scale vector similarity search, addressed by the cited works using FAISS, GPUs and FPGAs.</data>
  <data key="d3">doc-caa1a23d50101616a42f59c788898ea5-chunk-004&lt;SEP&gt;doc-caa1a23d50101616a42f59c788898ea5-chunk-013</data>
  <data key="d4">Paper_113-Accurate_AI_Assistance_in_Contract_Law1.pdf</data>
  <data key="d5">1791500933</data>
