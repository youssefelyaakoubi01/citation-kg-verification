  <data key="d12">1791466863</data>
  <data key="d13"></data>
</edge>
<edge source="Decentralized Authentication Mechanism for Mobile Ad hoc Networks" target="Distributed Authentication">
  <data key="d7">2.0</data>
  <data key="d8">The paper notes that security experts proposed distributed authentication for MANET due to the lack of a central authority to register and authenticate nodes.&lt;SEP&gt;The paper notes that in recent years security experts worldwide proposed distributed authentication for MANET because there is no central authority to register and authenticate nodes.</data>
  <data key="d9">addresses,background,related work</data>
  <data key="d10">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-000&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-001</data>
  <data key="d11">InfocomJ_2022_3_4_Khalfaoui.pdf</data>
  <data key="d12">1791466863</data>
  <data key="d13"></data>
</edge>
<edge source="Decentralized Authentication Mechanism for Mobile Ad hoc Networks" target="Community Network">
  <data key="d7">2.0</data>
  <data key="d8">Community networks in underserved areas motivate the use of MANET.&lt;SEP&gt;MANET is presented as a solution to reduce communication costs in community networks.</data>
  <data key="d9">addresses,motivation</data>
  <data key="d10">doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-000&lt;SEP&gt;doc-aaf2c8f641e35f769c72ec556a34ec4b-chunk-001</data>
