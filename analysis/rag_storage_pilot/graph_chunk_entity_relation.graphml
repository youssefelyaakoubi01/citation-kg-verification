  <data key="d0">10.1159/mvml24.120</data>
  <data key="d1">identifier</data>
  <data key="d2">DOI of the paper on Canny filter and CNN integration for defect detection.</data>
  <data key="d3">doc-5436254d7328f14e8f79864da9fef604-chunk-000</data>
  <data key="d4">MVML_120 (1).pdf</data>
  <data key="d5">1791467085</data>
